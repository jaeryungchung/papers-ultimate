# ─── API keys — NEVER commit ────────────────────────────────
.env
.env.*

# ─── Paper PDFs — copyrighted + large (~30MB); site builds fine without them
# **/*.pdf

# ─── Generated site — GitHub Actions rebuilds this on every push
site/

# NOTE: layout.json and ratings.json are NOT ignored — they hold the sidebar
# order and star ratings, and must be committed for the deployed site to
# reflect local changes. See README's GitHub Pages section.

# ─── Python ─────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ─── macOS / editors ────────────────────────────────────────
.DS_Store
**/.DS_Store
.vscode/
.idea/
